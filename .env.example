# Environment variables (no credentials in this file)
# Copy to .env and fill in values before running LLM phase

# Gemini API key (for optional LLM pilot, Phase 4 only)
GEMINI_API_KEY=your_key_here

# Modal token (for optional GPU inference, Phase 4 only)
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Optional: suppress debug output
LOG_LEVEL=INFO
