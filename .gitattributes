# Auto-normalize line endings to LF across all platforms
* text=auto eol=lf

# Strict LF line endings for all text deliverables, scripts, and documentation
*.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.jsonl text eol=lf
*.json text eol=lf

# Binary deliverables and assets (do not touch line endings or corrupt headers)
*.pdf binary
*.docx binary
*.zip binary
*.png binary
*.ico binary
